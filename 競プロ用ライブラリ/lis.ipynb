   "source": [
    "from bisect import bisect_left\n",
    "\n",
    "n=int(input())\n",
    "a=list(map(int,input().split()))\n",
    "\n",
    "lis=[a[0]]\n",
    "for i in range(1,n):\n",
    "    if lis[-1]<a[i]:\n",
    "        lis.append(a[i])\n",
    "    else:\n",
    "        idx=bisect_left(lis,a[i])\n",
    "        lis[idx]=a[i]"
   ]
  }
 ],
