   "source": [
    "def zaatu(a):\n",
    "    a.sort()\n",
    "    prev=-10**18\n",
    "    idx=0\n",
    "    d=dict()\n",
    "    for num in a:\n",
    "        d[num]=idx\n",
    "        dinv[idx]=num\n",
    "        if prev<num:\n",
    "            idx+=1\n",
    "            prev=num\n",
    "    return d,dinv"
   ]
  }
